# ---- API keys (optional) ----
FRED_API_KEY=                         # optional; empty = public fredgraph CSV endpoint
SHARADAR_API_KEY=             # owner sets it; Sharadar bundle key, default daily price source (SEP stocks, SFP for SPY/ETFs; P-16). Empty = local Stooq snapshot
TIINGO_API_KEY=                       # optional, unneeded: Stooq is local (P-07); kept only for an extra cross-check
GPRE_CLOUD_API_KEY=                   # optional; API/CLI key of the cloud GPU provider (D-16, P-17) if it has one; SSH keys stay in ~/.ssh

# ---- Cloud GPU (D-01, D-02, D-16) ----
GPRE_CLOUD_PROVIDER=                  # required before M2; provider chosen in D-16 (e.g. an hourly GPU cloud, or colab)
GPRE_GPU_BUDGET_USD=50                # approved cap (D-02)
GPRE_SPEND_LOG=./results/cloud_spend.csv  # required; one row per cloud session (NFR-12)

# ---- Paths ----
DATA_ROOT=~/data/gpu-pricing-risk-engine  # required; data root inside the WSL ext4 filesystem, never /mnt/* (~ expanded by the settings loader)
GPRE_DATA_DIR=                        # optional; root of raw/ interim/ processed/; empty = DATA_ROOT
GPRE_RESULTS_DIR=./results            # required; committed small JSON/CSV results
GPRE_REPORTS_DIR=./reports            # required; figures and tables
GPRE_SURFACE_PATH=                    # optional; vol-surface-modeling surface.json; empty = synthetic SSVI
STOOQ_DIR=/mnt/e/trading-strategy-brainstorm/data/stooq  # owner-supplied Stooq bulk daily snapshot (d_us_txt, d_world_txt; through 2026-10-30). Read once,
                                      # converted to Parquet under data/. Native Windows: E:\trading-strategy-brainstorm\data\stooq (P-07)

# ---- Runtime ----
GPRE_BACKEND=jax                      # required; jax | cuda | numpy | cpp
GPRE_DTYPE=float32                    # required; float32 | float64 (validation forces float64)
GPRE_SEED=20261030                    # required; master seed for Philox keys and Sobol scrambling
GPRE_LOG_LEVEL=INFO                   # optional; DEBUG | INFO | WARNING
GPRE_CPP_BASELINE=~/build/gpu-pricing-risk-engine/cpp/gpre_cpu_baseline  # optional; path to the C++ baseline binary (build dir on WSL ext4)
CUDA_HOME=/usr/local/cuda             # optional; CUDA toolkit root for NVRTC includes (cloud instance only)
CUDA_VISIBLE_DEVICES=0                # optional; which GPU to use (cloud instance only)

# ---- JAX / XLA ----
JAX_ENABLE_X64=0                      # optional; tests and validation set 1
XLA_PYTHON_CLIENT_PREALLOCATE=false   # required on 8 GB cards; stops JAX grabbing most VRAM at start
XLA_FLAGS=--xla_gpu_deterministic_ops=true   # optional; deterministic GPU reductions (check flag name in current XLA)
