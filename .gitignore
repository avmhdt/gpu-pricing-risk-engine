# Data: never commit raw or licensed data
data/
*.parquet
*.feather
*.h5
*.itch
*.pcap
*.gz
*.zst

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/

# C++ / Rust / CUDA builds
build/
cmake-build-*/
target/
*.o
*.obj
*.so
*.dll
*.pyd
*.exe

# Editors, OS, secrets
.vscode/
.idea/
.DS_Store
Thumbs.db
.env

# Local build spec (kept out of the public repo)
SPEC.html

# The data/ rule above also matches the package's own data module and schema folder
!src/gpre/data/
!src/gpre/data/**
# Small synthetic fixtures are committed (NFR-05)
!tests/fixtures/*.parquet
# Local outputs
.coverage
coverage.xml
.hypothesis/
# Re-ignore caches inside the re-included data package
__pycache__/
